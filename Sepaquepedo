local function format_number(n)
    if n >= 1000000000000 then
        return string.format("%.2fT", n / 1000000000000)
    elseif n >= 1000000000 then
        return string.format("%.2fB", n / 1000000000)
    elseif n >= 1000000 then
        return string.format("%.2fM", n / 1000000)
    elseif n >= 1000 then
        return string.format("%.2fK", n / 1000)
    else
        return tostring(n)
    end
end

local function get_thumbnail(imageid)
    local asset = string.split(imageid, "rbxassetid://")[2]
    if not asset then return "" end
    local size = "420x420"
    local image = safeGet(
        "https://thumbnails.roblox.com/v1/assets?assetIds=" ..
            asset .. "&returnPolicy=PlaceHolder&size=" .. size .. "&format=png"
    )
    if not image then return "" end
    local thumb = HttpService:JSONDecode(image).data[1].imageUrl
    return thumb
end

