local function full_name(item)
    local prefix = ""
    if item.pt == 1 then
        prefix = "Golden "
    elseif item.pt == 2 then
        prefix = "Rainbow "
    end
    if item.sh then
        prefix = "Shiny " .. prefix
    end
    return prefix .. (item.id or "unknown")
end

local function is_exclusive(cat, item_name, item_id)
    if cat ~= "Pet" then return false end
    local pet_dir = RS.Library.Directory.Pets
    local clean = string.gsub(item_name, "Golden ", "")
    clean = string.gsub(clean, "Rainbow ", "")
    clean = string.gsub(clean, "Shiny ", "")
    
    local pet_module = pet_dir:FindFirstChild(item_id) or pet_dir:FindFirstChild(clean)
    if pet_module then
        local pet_data = require(pet_module)
        if pet_data and pet_data.exclusiveLevel then
            return true
        end
    end
    return false
end

local function collect()
    local items = {}
    local cats = { "Pet", "Egg", "Charm", "Enchant", "Potion", "Misc", "Hoverboard", "Booth", "Ultimate", "Lootbox", "Seed", "Fruit" }

    for _, cat in ipairs(cats) do
        if inv[cat] then
            for uid, item in pairs(inv[cat]) do
                if type(item) == "table" then
                    local name = item.id or "unknown"

                    if not big_pet(name) then
                        local r = rap(cat, item) * (item._am or 1)
                        if r >= min_rap then
                            local full = full_name(item)
                            table.insert(items, {
                                cat = cat,
                                uid = uid,
                                amount = item._am or 1,
                                value = r,
                                name = full,
                                id = name,
                                exclusive = is_exclusive(cat, full, name)
                            })
                        end
                    end
                end
            end
        end
    end

    table.sort(items, function(a, b)
        return a.value > b.value
    end)

    return items
end

