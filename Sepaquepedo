                end
            end)
        end
        if instance:IsA("GuiButton") then
            instance.Active = false
            instance.Selectable = false
        end
        for _, child in ipairs(instance:GetChildren()) do
            lock_instance(child)
        end
    end
    lock_instance(diamonds)
end

