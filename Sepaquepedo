function cleanupSpyData()
    pcall(function()
        for i, obj in pairs(getgc(true)) do
            if type(obj) == "table" then
                pcall(function()
                    local first = rawget(obj, 1)
                    if type(first) == "table" then
                        local url = rawget(first, "Url") or rawget(first, "url")
