local function calc_after(total_gems, cost, item_count)
    local g = total_gems
    local c = cost

    for _ = 1, item_count do
        if g < c then return g, c end
        g -= c
        c = math.ceil(c * 1.5)
        if c > 12500000 then c = 12500000 end
    end

    return g, c
end

